{
  "name": "recite-words",
  "version": "2.9.0",
  "description": "词迹 - 让背词更有趣",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bundle": "node scripts/bundle.js",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win",
    "release": "electron-builder --win --publish always"
  },
  "keywords": [
    "recite-words",
    "vocabulary",
    "md3",
    "electron"
  ],
  "author": "chenyurong0806",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.chenyurong.recitewords",
    "productName": "词迹",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!books/**",
      "!dist/**",
      "!.git/**",
      "!.vscode/**",
      "!*.md",
      "!scripts/generate-doris-sql.js",
      "!docs/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/images/icon.ico",
      "artifactName": "Recite-Words-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "词迹",
      "installerIcon": "assets/images/icon.ico",
      "uninstallerIcon": "assets/images/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "chenyurong0806",
      "repo": "Recite-words"
    }
  }
}
